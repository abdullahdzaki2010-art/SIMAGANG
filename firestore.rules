rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || incoming().id == userId);
      allow delete: if false;
    }

    // Attendances Collection
    match /attendances/{attendanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().studentId is string;
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Logbooks Collection
    match /logbooks/{logbookId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().studentId is string;
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Vacancies Collection
    match /vacancies/{vacancyId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Applications Collection
    match /applications/{applicationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().studentId is string;
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Evaluations Collection
    match /evaluations/{studentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }
  }
}
